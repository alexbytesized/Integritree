# Local Python environments and generated files
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
*.log

# Local settings and secrets; keep the documented example
.env
.env.*
!.env.example

# Data and generated outputs; retain directory markers
/data/raw/*
!/data/raw/.gitkeep
/data/prepared/*
!/data/prepared/.gitkeep
/artifacts/*
!/artifacts/.gitkeep
/reports/*
!/reports/.gitkeep
/runtime/uploads/*
!/runtime/uploads/.gitkeep
/runtime/exports/*
!/runtime/exports/.gitkeep
