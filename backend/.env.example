# Optional: copy this file to backend/.env. Defaults work without copying it.
# Relative paths below are resolved against the backend root, never shell cwd.
INTEGRITREE_DATASET_PATH=data/raw/ps_raw.csv
INTEGRITREE_EXPERIMENT_CONFIG=configs/experiment.yaml
INTEGRITREE_PREPARED_DIR=data/prepared
INTEGRITREE_ARTIFACTS_DIR=artifacts
INTEGRITREE_REPORTS_DIR=reports
INTEGRITREE_UPLOADS_DIR=runtime/uploads
INTEGRITREE_EXPORTS_DIR=runtime/exports
INTEGRITREE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# To relocate the backend root, set INTEGRITREE_BACKEND_ROOT to an absolute
# directory in the process environment BEFORE startup (not in this file).
